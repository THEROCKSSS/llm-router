# ============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env.
# ============================================================================
# The launcher (scripts/start-bridge.sh) reads secrets from small files or the
# environment; this file documents every variable the config expects.

# --- core -------------------------------------------------------------------
# Admin key for the proxy dashboard + management API. Generate a strong one,
# e.g.  LITELLM_MASTER_KEY="sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Postgres DSN used for keys + spend logs. 127.0.0.1, not "localhost"
# (on Windows, "localhost" can resolve to IPv6 ::1 and fail to connect).
LITELLM_DATABASE_URL=postgresql://llmrouter:CHANGE_ME@127.0.0.1:5434/litellm

# Dashboard UI login (optional).
UI_USERNAME=
UI_PASSWORD=

# --- lanes -------------------------------------------------------------------
# Lane 1: your first OpenAI-compatible upstream
UPSTREAM_A_API_KEY=
UPSTREAM_A_BASE_URL=http://127.0.0.1:9001/v1

# Lane 2: OpenRouter (wildcard lane — any model, incl. new ones)
OPENROUTER_API_KEY=

# Lane 3: Ollama cloud
OLLAMA_API_KEY=

# Lane 5 (optional custom provider): any key your custom handler needs
# MYPROV_API_KEY=

# --- local decision engine (Lane 4 / Laya) ----------------------------------
# No key needed; the wrapper lives at scripts/laya_server.py and listens on
# LAYA_PORT (default 4030). Set LAYA_DEVICE=cuda / cpu to force a device.
LAYA_PORT=4030
# LAYA_DEVICE=cuda
